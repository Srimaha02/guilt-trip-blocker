{
  "manifest_version": 3,
  "name": "Guilt Trip Blocker",
  "version": "3.0",
  "description": "Blocks distracting sites with Savage Tanglish guilt trips, Earn-Your-Scroll CS challenges, YouTube Shorts filter, and a live Focus Dashboard.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "https://*.vercel.app/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon128.png",
      "48": "icon128.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon128.png",
    "48": "icon128.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}